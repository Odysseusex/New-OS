// Bakery OS — canonical data model.
// This schema is the internal "source of truth" that every external system
// (UMAG, iiko, 1C, CSV, webhooks) gets translated into via the integrations layer.
// Business modules (Sales, Inventory, Production, ...) all read/write this model,
// never the external systems directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  REGIONAL_MANAGER
  STORE_MANAGER
  PRODUCTION_MANAGER
  PRODUCTION_STAFF
  WAREHOUSE_STAFF
  DRIVER
  CASHIER
  ACCOUNTANT
  HR_MANAGER
  ADMIN
}

enum LocationType {
  BAKERY_PRODUCTION
  STORE
  WAREHOUSE
}

enum Unit {
  PCS
  KG
  G
  L
}

enum StockMovementType {
  RECEIPT
  SALE
  WRITE_OFF
  ADJUSTMENT
}

// A tenant of the platform — one bakery network / company.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions   Region[]
  locations Location[]
  users     User[]

  @@map("organizations")
}

// Optional grouping of locations used for regional roll-up reporting.
model Region {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  locations Location[]
  users     User[]

  @@index([organizationId])
  @@map("regions")
}

// A physical place: a bakery/production site, a retail store, or a warehouse.
// This is also the anchor entity for the interactive city map module.
model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String?
  region         Region?      @relation(fields: [regionId], references: [id])

  name    String
  type    LocationType
  city    String
  address String
  lat     Float?
  lng     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]

  @@index([organizationId])
  @@index([regionId])
  @@map("locations")
}

// A platform user. Access scope is derived from role + organization + optional
// region/location assignment (enforced in the RBAC guard, not in the DB).
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String?
  region         Region?      @relation(fields: [regionId], references: [id])
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id])

  fullName     String
  email        String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  sales          Sale[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// Product/ingredient catalog — shared by Sales, Inventory and (later) Production.
model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sku            String
  unit           Unit
  category       String
  price          Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

// Current quantity on hand for a product at a specific location.
model StockLevel {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Decimal  @default(0) @db.Decimal(12, 3)
  minQuantity    Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt

  @@unique([locationId, productId])
  @@index([organizationId])
  @@map("stock_levels")
}

// Append-only ledger of every stock change — the audit trail behind StockLevel.
model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  locationId     String
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  reason         String?
  saleId         String?
  sale           Sale?             @relation(fields: [saleId], references: [id])
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([organizationId, locationId])
  @@map("stock_movements")
}

model Sale {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  soldAt         DateTime @default(now())
  totalAmount    Decimal  @db.Decimal(12, 2)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])

  items          SaleItem[]
  stockMovements StockMovement[]

  @@index([organizationId, locationId])
  @@index([soldAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@map("sale_items")
}
