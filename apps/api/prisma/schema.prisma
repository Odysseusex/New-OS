// Bakery OS — canonical data model.
// This schema is the internal "source of truth" that every external system
// (UMAG, iiko, 1C, CSV, webhooks) gets translated into via the integrations layer.
// Business modules (Sales, Inventory, Production, ...) all read/write this model,
// never the external systems directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  REGIONAL_MANAGER
  STORE_MANAGER
  PRODUCTION_MANAGER
  PRODUCTION_STAFF
  WAREHOUSE_STAFF
  DRIVER
  CASHIER
  ACCOUNTANT
  HR_MANAGER
  ADMIN
  OPERATOR
}

enum LocationType {
  BAKERY_PRODUCTION
  STORE
  WAREHOUSE
}

enum LocationOwnership {
  OWNED
  FRANCHISE
}

enum Unit {
  PCS
  KG
  G
  L
  ML
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_GOOD
}

enum StockMovementType {
  RECEIPT
  SALE
  // Goods handed back by a buyer. A separate type from RECEIPT so returns
  // never look like a purchase arriving from a supplier.
  SALE_RETURN
  WRITE_OFF
  ADJUSTMENT
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  TRANSFER_OUT
  TRANSFER_IN
}

// Categorizes a WRITE_OFF movement so losses can be tracked and reported by
// cause, not just as an undifferentiated "списание". Only meaningful when
// StockMovement.type is WRITE_OFF.
enum WriteOffReason {
  EXPIRED
  DAMAGED
  PRODUCTION_DEFECT
  QUALITY_ISSUE
  OTHER
}

enum ProductionBatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Categorizes why a batch was cancelled/aborted, mirroring the WriteOffReason
// pattern — required when aborting an IN_PROGRESS batch (equipment/ingredient
// problems are worth reporting on), optional when cancelling a PLANNED one
// that was simply created by mistake.
enum ProductionCancelReason {
  EQUIPMENT_FAILURE
  NO_INGREDIENTS
  MISTAKE
  OTHER
}

enum PurchaseOrderStatus {
  PLACED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Where an invoice's data originated. MANUAL is the only path today —
// AI_SCAN and API_SYNC are placeholders so a future paper-photo OCR flow or
// a UMAG/1С sync can populate invoices without another schema migration.
enum InvoiceSource {
  MANUAL
  AI_SCAN
  API_SYNC
}

enum VehicleStatus {
  AVAILABLE
  ON_ROUTE
  MAINTENANCE
}

enum DeliveryRouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RouteStopStatus {
  PENDING
  DELIVERED
}

enum ExpenseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ShiftStatus {
  SCHEDULED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// The rate/frequency a compensation figure is quoted in — a label only,
// deliberately not fed into any calculation engine yet (no payroll exists).
// Kept flexible now so a future payroll module isn't blocked by having to
// add this later.
enum CompensationType {
  MONTHLY
  HOURLY
  PIECE_RATE
}

enum CashAccountType {
  BANK
  CASH
}

enum FinanceCategoryKind {
  INCOME
  EXPENSE
}

// Cost behavior for management accounting (break-even, contribution
// margin) — orthogonal to FinanceCategoryKind (income/expense). Only
// meaningful for EXPENSE categories. UNCLASSIFIED is the explicit default
// on every new/existing category — never silently guessed, since not every
// expense can be classified from its name alone (see FinanceCategory.costBehavior).
enum CostBehavior {
  FIXED
  VARIABLE
  UNCLASSIFIED
}

// The closed set of ways a CashMovement can happen. Which side of the
// account it hits (in vs out) is implicit in the type, the same way
// StockMovementType conveys direction for StockMovement — no separate
// "direction" column.
enum CashMovementType {
  OPENING_BALANCE
  SALE_RECEIPT
  // Money handed back to a buyer. Stored as a positive magnitude like every
  // other type except ADJUSTMENT; the type is what makes it an outflow.
  SALE_REFUND
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE_PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  OTHER_INCOME
  OTHER_EXPENSE
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  // Split across more than one method in a single sale — the buyer put part
  // on a card and paid the rest in cash. Never appears on a SalePayment row
  // itself (each of those is one real method); only on Sale.paymentMethod,
  // where it means "see the payments relation for the breakdown".
  MIXED
}

// Where a sale stands with the fiscal operator (ККМ/ОФД).
//   PENDING   — staged, not sent yet.
//   SENDING   — claimed by one attempt; only that attempt may call the API.
//   REGISTERED— the provider confirmed a fiscal receipt. Terminal, and the
//               only state in which money/stock may move (see the fiscal
//               section in CLAUDE.md).
//   FAILED    — the provider rejected it for a stated reason. Retryable
//               after the cause is fixed; the SAME externalId is reused so a
//               retry can never double-punch.
//   UNKNOWN   — the call timed out or the connection dropped, so we do NOT
//               know whether a receipt exists. Never auto-retried blindly:
//               it must first be resolved against the provider by externalId.
enum FiscalReceiptStatus {
  PENDING
  SENDING
  REGISTERED
  FAILED
  UNKNOWN
}

// A tenant of the platform — one bakery network / company.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Atomically incremented to hand out unique auto-generated product SKUs
  // (see ProductsService.generateSku) without a retry loop under concurrent
  // creates — Prisma's `increment` compiles to a single atomic UPDATE.
  productSkuSequence Int @default(0)

  // "Запуск финансового учёта" (FinanceSetupService) — set once, ever, when
  // the owner finalizes the opening financial position after adopting the
  // Finance module on top of pre-existing stock/production/sales history.
  // financeInitializedAt gates re-running the setup flow (see
  // FinanceSetupService.complete) and blocks CashAccount.openingBalance
  // afterwards (see CashAccountsService.create) — a new account opened
  // later always starts at zero and is funded by an ordinary deposit or
  // transfer, never another "opening balance", so summing OPENING_BALANCE
  // CashMovements stays a stable, permanent record of cash at go-live with
  // no separate frozen cash field needed.
  //
  // The three opening* values are a frozen historical snapshot, not a
  // cache — inventory cost and outstanding balances both drift after
  // go-live (prices change, debts get paid down), so recomputing them
  // live would silently rewrite history. Once set, they are immutable:
  // later corrections go through normal ERP mechanisms (stock adjustment,
  // cash ADJUSTMENT, ordinary expense/invoice payment) — never by editing
  // these fields directly. No API route exists to update them post-set.
  financeInitializedAt    DateTime?
  financeInitializedById  String?
  financeInitializedBy    User?     @relation("FinanceInitializedBy", fields: [financeInitializedById], references: [id])
  openingInventoryValue   Decimal?  @db.Decimal(14, 2)
  openingReceivablesValue Decimal?  @db.Decimal(14, 2)
  openingPayablesValue    Decimal?  @db.Decimal(14, 2)

  regions   Region[]
  locations Location[]
  users     User[]
  invoices  Invoice[]
  employees Employee[]

  plannedFixedCosts PlannedFixedCost[]

  @@map("organizations")
}

// Optional grouping of locations used for regional roll-up reporting.
model Region {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  locations Location[]
  users     User[]

  @@index([organizationId])
  @@map("regions")
}

// A physical place: a bakery/production site, a retail store, or a warehouse.
// This is also the anchor entity for the interactive city map module.
model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String?
  region         Region?      @relation(fields: [regionId], references: [id])

  name      String
  type      LocationType
  ownership LocationOwnership @default(OWNED)
  city      String
  address   String
  lat       Float?
  lng       Float?
  isActive  Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  productionBatches ProductionBatch[]
  purchaseOrders    PurchaseOrder[]
  invoices          Invoice[]
  originRoutes      DeliveryRoute[]   @relation("RouteOrigin")
  destinationStops  RouteStop[]       @relation("RouteDestination")
  expenses          Expense[]
  shifts            Shift[]
  timeEntries       TimeEntry[]
  cashAccounts      CashAccount[]
  employees         Employee[]
  plannedFixedCosts PlannedFixedCost[]
  productPrices     ProductLocationPrice[]

  @@index([organizationId])
  @@index([regionId])
  @@map("locations")
}

// A platform user. Access scope is derived from role + organization + optional
// region/location assignment (enforced in the RBAC guard, not in the DB).
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String?
  region         Region?      @relation(fields: [regionId], references: [id])
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id])

  fullName     String
  email        String
  passwordHash String
  role         Role
  // Optional custom display label shown instead of the role name in the
  // topbar (e.g. "Разработчик" for someone who's technically OWNER-level
  // but isn't "the bakery owner" in the everyday sense) — purely cosmetic,
  // never affects permissions, which are still entirely driven by role.
  title        String?
  isActive     Boolean @default(true)
  // Set once the user completes the one-time linking flow from
  // Settings → Telegram. Looked up on every incoming bot update to resolve
  // the same AuthenticatedUser shape the web JWT flow produces — there is no
  // separate "Telegram identity" or permission model, just this pointer.
  telegramId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements         StockMovement[]
  sales                  Sale[]
  saleReturns            SaleReturn[]
  productionBatches      ProductionBatch[]
  purchaseOrders         PurchaseOrder[]
  createdRoutes          DeliveryRoute[]         @relation("RouteCreatedBy")
  drivenRoutes           DeliveryRoute[]         @relation("RouteDriver")
  expenses               Expense[]
  shiftsCreated          Shift[]                 @relation("ShiftCreatedBy")
  // Who physically performed a TimeEntry's clock-in/out — the employee
  // themself (self-service) or a manager acting on behalf of an employee
  // with no ERP login. See TimeEntry.recordedById.
  timeEntriesRecorded    TimeEntry[]             @relation("TimeEntryRecordedBy")
  recipeRevisions        RecipeRevision[]
  invoices               Invoice[]
  notificationDismissals NotificationDismissal[]
  cashMovements          CashMovement[]
  financeInitializedOrgs Organization[]          @relation("FinanceInitializedBy")
  // Optional — not every real employee has ERP access, and not every User
  // necessarily has to correspond to a tracked Employee (though in
  // practice everyone with a login is also a real person on staff).
  employee               Employee?
  compensationsCreated   EmployeeCompensation[]
  plannedFixedCostsCreated PlannedFixedCost[]
  telegramLinkTokens        TelegramLinkToken[]
  telegramPendingActions    TelegramPendingAction[]
  telegramChatState         TelegramChatState?
  telegramNotificationLogs  TelegramNotificationLog[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// A user-managed grouping for the product catalog (e.g. "Мука", "Хлеб",
// "Упаковка"). Purely organizational — does not affect recipe logic, unlike
// ProductType below.
model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

// Product/ingredient catalog — shared by Sales, Inventory and (later) Production.
model Product {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  sku            String
  unit           Unit
  type           ProductType @default(FINISHED_GOOD)
  categoryId     String?
  categoryRef    Category?   @relation(fields: [categoryId], references: [id])
  // Dual meaning depending on `type` — same column, different semantics:
  //   - FINISHED_GOOD: the client SALE price (what Sale/SaleItem charge).
  //   - RAW_MATERIAL:  the COST input consumed by recipe cost calculations
  //     (RecipesService.toDto, FinanceService P&L/inventory valuation) — it
  //     is NEVER a sale price, even though raw materials are occasionally
  //     sold directly. Never use FINISHED_GOOD.price when valuing stock as
  //     an asset (inventory valuation, opening balances) — that would price
  //     an asset at what a customer pays for it, not what it cost to have on
  //     hand. Finished-goods valuation must go through recipe cost (or
  //     average purchase cost as a fallback), never this field.
  price          Decimal     @db.Decimal(12, 2)
  // The barcode physically printed on the packaging (EAN-13 and friends) —
  // what a scanner reads at the till. Distinct from `sku`, which this system
  // generates itself and which never appears on a package. Optional because
  // own fresh production (bread, cakes) carries no barcode at all and is
  // rung up by tapping a tile instead; only resold packaged goods have one.
  barcode        String?
  // NTIN — code from Kazakhstan's National Catalogue of Goods (НКТ), also
  // re:Kassa's `ntin` field. Not to be confused with ИКПУ, the equivalent
  // term used in Uzbekistan — a mix-up this codebase made once already.
  // Every receipt line has been legally required to carry it since
  // 01.01.2026, so a sale can't be fiscalised until the products in it have
  // one. Not validated here: the fiscal operator is the authority and
  // rejects a wrong code, so a local format check would only invent a second
  // opinion that can drift out of date.
  ntin           String?
  // False for resources with no physical stock to track (e.g. tap water) —
  // still usable in recipes and cost calculations, but excluded from stock
  // levels, low-stock alerts, and receiving/write-off/adjustment operations.
  // A sale of such a product also skips the stock check and writes no
  // StockMovement: there is no stock to move.
  trackInventory Boolean     @default(true)
  // The till's "произвольная сумма" line: a product whose price is typed by
  // the cashier at the moment of sale instead of coming from `price`. Exists
  // so an item that has not been received into the catalogue yet cannot stop
  // the till. There is at most one per organization, created on demand by
  // ProductsService.getOrCreateOpenPrice(), and it is deliberately
  // trackInventory=false — it stands for goods the system does not know
  // about, so it has no stock to check or decrement.
  isOpenPrice    Boolean     @default(false)
  // The organization's chosen low-stock threshold for this product, copied
  // onto each StockLevel row (see stockLevel.minQuantity) the first time
  // that product is stocked at a given location, and re-propagated to all
  // existing StockLevel rows whenever this value is edited — so it behaves
  // as one number per product even though the underlying per-location field
  // still exists for a future per-location override, if one is ever needed.
  minQuantity    Decimal     @default(0) @db.Decimal(12, 3)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  locationPrices     ProductLocationPrice[]
  saleItems          SaleItem[]
  saleReturnItems    SaleReturnItem[]
  recipe             Recipe?             @relation("RecipeOutput")
  usedInRecipeItems  RecipeItem[]        @relation("RecipeIngredient")
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  routeStopItems     RouteStopItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  // Deliberately an index, not a unique constraint: two products legitimately
  // sharing a barcode is a data-entry problem to surface, not a write to
  // reject — and a unique constraint over a nullable column would also have
  // to reason about the many rows that have no barcode at all.
  @@index([organizationId, barcode])
  @@map("products")
}

// Current quantity on hand for a product at a specific location.
// What a product costs AT ONE POINT OF SALE, when that differs from
// Product.price.
//
// Product.price stays the default and is what almost everything in the app
// means by "the price" — wholesale, in this business. A row here overrides it
// for one location only: the retail point rents space inside a customer's
// supermarket and sells the same bread at retail. Deliberately an override
// table rather than a second price column on Product, so a third and fourth
// point with their own prices need no schema change, and so only the products
// that actually differ have to be filled in.
//
// Nothing reads this except price resolution for the till (and the screen
// that edits it) — a Sale still stores the unit price it was rung up at, so
// changing a price here never rewrites history.
model ProductLocationPrice {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  price          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([organizationId, locationId])
  @@map("product_location_prices")
}

model StockLevel {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Decimal  @default(0) @db.Decimal(12, 3)
  minQuantity    Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt

  @@unique([locationId, productId])
  @@index([organizationId])
  @@map("stock_levels")
}

// Append-only ledger of every stock change — the audit trail behind StockLevel.
model StockMovement {
  id              String            @id @default(cuid())
  organizationId  String
  locationId      String
  location        Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  reason          String?
  writeOffReason  WriteOffReason?
  saleId          String?
  sale            Sale?             @relation(fields: [saleId], references: [id])
  saleReturnId    String?
  saleReturn      SaleReturn?       @relation(fields: [saleReturnId], references: [id])
  batchId         String?
  batch           ProductionBatch?  @relation(fields: [batchId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  routeStopId     String?
  routeStop       RouteStop?        @relation(fields: [routeStopId], references: [id])
  invoiceId       String?
  invoice         Invoice?          @relation(fields: [invoiceId], references: [id])
  createdById     String
  createdBy       User              @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([organizationId, locationId])
  @@map("stock_movements")
}

model Sale {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  soldAt         DateTime  @default(now())
  totalAmount    Decimal   @db.Decimal(12, 2)
  // How much of totalAmount has been collected so far. Walk-in retail sales
  // are always paid in full at creation; wholesale customer orders may be
  // placed on credit and paid down over time via recordPayment().
  amountPaid     Decimal   @default(0) @db.Decimal(12, 2)
  // Which CashAccount a payment lands in: CASH -> the selling location's
  // cash register, CARD/TRANSFER -> the organization's default bank account.
  // MIXED means the sale was split; the `payments` rows carry the real
  // methods and amounts, and the money lands in more than one account.
  // Kept as a column (rather than derived from `payments`) so every existing
  // group-by-payment-method query keeps working untouched.
  paymentMethod  PaymentMethod @default(CASH)
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id])

  items          SaleItem[]
  payments       SalePayment[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  fiscalReceipt  FiscalReceipt?
  returns        SaleReturn[]

  @@index([organizationId, locationId])
  @@index([soldAt])
  @@map("sales")
}

// One tender of a split sale: «2 000 ₸ картой, остальное наличными».
//
// Written ONLY when a sale is actually split — a single-method sale carries
// everything it needs on Sale.paymentMethod, and inventing a one-row payment
// for it would mean two places to keep in step for no gain.
//
// This is what makes the money land correctly: cash goes to the location's
// till account and card to the bank account, so a split sale produces two
// CashMovement rows, not one. Without it the финансы module would show the
// whole amount in whichever account happened to be picked.
model SalePayment {
  id             String        @id @default(cuid())
  organizationId String
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Never MIXED — that value only ever describes the sale as a whole.
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@index([organizationId, saleId])
  @@map("sale_payments")
}

// The fiscal side of a Sale: one receipt per sale, tracked separately so the
// sale row itself stays the plain commercial document it has always been.
//
// This table is the retry-safety mechanism, in the same spirit as
// TelegramPendingAction: `externalId` is generated once, sent as re:Kassa's
// X-Request-ID, and REUSED on every retry of that same sale. re:Kassa treats a
// repeat of the same external id within a shift as the same request, so a
// retry after a timeout cannot punch a second receipt. Never regenerate it.
model FiscalReceipt {
  id             String              @id @default(cuid())
  organizationId String
  // Null until the sale row exists. The receipt is punched FIRST and the
  // sale is written only once it is registered, so that a Sale in this
  // database is always a complete, real sale — never a half-finished one
  // that reports would have to learn to exclude. A receipt still sitting
  // here with no saleId is therefore a receipt that was punched but whose
  // sale did not get recorded: rare, and deliberately visible.
  saleId         String?             @unique
  sale           Sale?               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Exactly one of saleId / saleReturnId is set. A return receipt goes through
  // the identical staging, retry and reconciliation machinery — the operation
  // it carries differs, the plumbing does not.
  saleReturnId   String?             @unique
  saleReturn     SaleReturn?         @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  status         FiscalReceiptStatus @default(PENDING)

  // Our idempotency key (a UUID), sent as X-Request-ID. Unique per
  // organization so a collision can never silently merge two sales.
  externalId String @unique

  // Exactly what we asked the operator to punch, stored before the first
  // call. A retry must resend byte-identical content under the same
  // externalId, and after a timeout there may be no sale row to rebuild it
  // from — so it is kept rather than re-derived.
  requestPayload Json?

  // --- Filled in from the provider's answer once registered. ---
  // Everything below is also what a later RETURN receipt must quote back
  // about the original (re:Kassa's `parentTicket` block), which is why the
  // response is preserved rather than reduced to a number.
  providerTicketId    String?
  ticketNumber        String?
  offlineTicketNumber String?
  // True when the provider registered it in offline mode — the return
  // receipt has to carry this flag back verbatim.
  isOffline           Boolean  @default(false)
  qrCode              String?
  kgdKkmId            String?
  shiftNumber         Int?
  registeredAt        DateTime?
  // The raw provider response, kept whole: the return payload needs fields
  // we don't model individually, and a fiscal answer is evidence worth
  // keeping verbatim rather than re-deriving later.
  providerResponse    Json?

  // Last failure reason, shown to the cashier as-is. Cleared on success.
  errorCode    String?
  errorMessage String?
  attempts     Int      @default(0)
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("fiscal_receipts")
}

// A buyer handing goods back. A separate, append-only document rather than an
// edit of the Sale: a confirmed sale is immutable (see CLAUDE.md), and the
// money and stock a return moves belong in the same single ledgers every
// other flow writes to — hence the nullable saleReturnId on StockMovement and
// CashMovement rather than tables of their own.
//
// Partial returns are the normal case (one loaf out of three), so items carry
// their own quantities and never have to match the sale line for line.
model SaleReturn {
  id             String   @id @default(cuid())
  organizationId String
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id])
  // Where the goods came back to. Always the selling location: a return is
  // handled at the till that made the sale.
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  returnedAt     DateTime @default(now())
  // Money handed back, always positive.
  totalAmount    Decimal  @db.Decimal(12, 2)
  reason         String?
  // Whether the goods went back on the shelf. False for anything a buyer
  // already carried home and cannot be resold — bread, mostly — in which
  // case the stock is written off instead of restocked, and the ledger says
  // so rather than quietly inflating what is on hand.
  restocked      Boolean  @default(true)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  items          SaleReturnItem[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  fiscalReceipt  FiscalReceipt?

  @@index([organizationId, saleId])
  @@index([returnedAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(12, 3)
  // Copied from the sale line, never re-read from the product: a buyer is
  // refunded what they actually paid, not today's price.
  unitPrice    Decimal    @db.Decimal(12, 2)
  subtotal     Decimal    @db.Decimal(12, 2)

  @@map("sale_return_items")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@map("sale_items")
}

// A техкарта: how many units of `product` one batch of this recipe yields,
// and which ingredients (other products) it consumes to get there.
model Recipe {
  id             String  @id @default(cuid())
  organizationId String
  productId      String  @unique
  product        Product @relation("RecipeOutput", fields: [productId], references: [id], onDelete: Cascade)
  yieldQuantity  Decimal @db.Decimal(12, 3)
  isActive       Boolean @default(true)

  // Recipe-level (not process-stage-specific) technological card fields.
  // All optional so an old-style recipe still works.
  generalNotes  String?
  pieceWeightG  Decimal? @db.Decimal(8, 2)
  lossPercent   Decimal? @db.Decimal(5, 2)
  shelfLifeDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     RecipeItem[]
  stages    RecipeStage[]
  revisions RecipeRevision[]
  batches   ProductionBatch[]

  @@index([organizationId])
  @@map("recipes")
}

model RecipeItem {
  id                  String  @id @default(cuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product @relation("RecipeIngredient", fields: [ingredientProductId], references: [id])
  quantity            Decimal @db.Decimal(12, 3)

  @@map("recipe_items")
}

// Organization-wide catalog of process stages (Замес, Брожение, Выпечка,
// Сборка, ...). Deliberately generic and extensible — bread, viennoiserie
// and cakes all describe their process as an ordered pick from this same
// catalog rather than each needing their own hardcoded set of stages.
model RecipeStageType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stages RecipeStage[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("recipe_stage_types")
}

// One stage instance within a specific recipe's process, in this recipe's
// own order. Carries free-text notes plus zero or more structured
// parameters — this is what used to be split across RecipeStep (text) and
// Recipe's fixed baking/proofing/etc. columns (numbers).
model RecipeStage {
  id          String          @id @default(cuid())
  recipeId    String
  recipe      Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stageTypeId String
  stageType   RecipeStageType @relation(fields: [stageTypeId], references: [id])
  sequence    Int
  note        String?

  parameters RecipeStageParameter[]

  @@index([recipeId])
  @@map("recipe_stages")
}

// The fixed, closed set of measurement kinds a stage parameter can be —
// these are the actual physical dimensions a bakery process is measured
// in, not a per-concept list, so it doesn't grow as new stage types or
// product categories are added.
enum RecipeParameterKind {
  TEMPERATURE_C
  DURATION_MINUTES
  PERCENT
  WEIGHT_G
  COUNT
}

// A single measured value on a stage (e.g. kind=TEMPERATURE_C on a
// "Расстойка" stage = proofing temperature). `label` disambiguates two
// parameters of the same kind on one stage (e.g. mixing time "медленно"
// vs "быстро").
model RecipeStageParameter {
  id      String              @id @default(cuid())
  stageId String
  stage   RecipeStage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  kind    RecipeParameterKind
  label   String?
  value   Decimal             @db.Decimal(10, 2)

  @@index([stageId])
  @@map("recipe_stage_parameters")
}

// A lightweight audit trail: one row per edit, recording who changed the
// techcard and a human-readable summary of what changed (not a full diff).
model RecipeRevision {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())
  summary     String

  @@index([recipeId])
  @@map("recipe_revisions")
}

// A planned/completed run of a recipe at a production location. Completing a
// batch is the event that turns raw ingredients into finished-goods stock.
model ProductionBatch {
  id              String                  @id @default(cuid())
  organizationId  String
  locationId      String
  location        Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recipeId        String
  recipe          Recipe                  @relation(fields: [recipeId], references: [id])
  status          ProductionBatchStatus   @default(PLANNED)
  plannedQuantity Decimal                 @db.Decimal(12, 3)
  actualQuantity  Decimal?                @db.Decimal(12, 3)
  scheduledFor    DateTime                @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  cancelReason    ProductionCancelReason?
  cancelNote      String?
  createdById     String
  createdBy       User                    @relation(fields: [createdById], references: [id])
  createdAt       DateTime                @default(now())

  stockMovements StockMovement[]

  @@index([organizationId, locationId])
  @@map("production_batches")
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  cashMovements  CashMovement[]

  @@index([organizationId])
  @@map("suppliers")
}

// An order placed with a supplier to replenish stock at one location.
// Receiving it is the event that turns the order into actual StockLevel/
// StockMovement entries — mirroring how ProductionBatch.complete() works.
model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  locationId     String
  location       Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  status         PurchaseOrderStatus @default(PLACED)
  totalCost      Decimal             @db.Decimal(12, 2)
  orderedAt      DateTime            @default(now())
  receivedAt     DateTime?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])

  items          PurchaseOrderItem[]
  stockMovements StockMovement[]

  @@index([organizationId, locationId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// A documented delivery note — what a supplier physically hands over with
// goods, transcribed into the system (today by hand; AI_SCAN/API_SYNC are
// future sources for the same shape of record). Confirming one is the
// formal, paper-trailed way to receive stock, independent of whether a
// PurchaseOrder was placed first.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  number         String
  issuedAt       DateTime      @default(now())
  status         InvoiceStatus @default(DRAFT)
  source         InvoiceSource @default(MANUAL)
  photoUrl       String?
  externalSyncId String?
  notes          String?
  totalCost      Decimal       @db.Decimal(12, 2)
  // Supplier accounts payable — 0 until confirmed and paid down via
  // recordPayment(), same increment-only shape as Sale.amountPaid. Only
  // meaningful once status = CONFIRMED (a DRAFT invoice owes nothing yet).
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          InvoiceItem[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]

  @@index([organizationId, locationId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitCost  Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model Vehicle {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  plateNumber    String
  status         VehicleStatus @default(AVAILABLE)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  routes DeliveryRoute[]

  @@index([organizationId])
  @@map("vehicles")
}

// A delivery run: goods leave one location (production/warehouse) and are
// dropped off at one or more stops (usually stores). Delivering a stop is
// the event that transfers stock from the origin to that destination.
model DeliveryRoute {
  id               String              @id @default(cuid())
  organizationId   String
  originLocationId String
  originLocation   Location            @relation("RouteOrigin", fields: [originLocationId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?            @relation(fields: [vehicleId], references: [id])
  driverId         String?
  driver           User?               @relation("RouteDriver", fields: [driverId], references: [id])
  status           DeliveryRouteStatus @default(PLANNED)
  scheduledFor     DateTime            @default(now())
  createdById      String
  createdBy        User                @relation("RouteCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())

  stops RouteStop[]

  @@index([organizationId])
  @@map("delivery_routes")
}

model RouteStop {
  id                    String          @id @default(cuid())
  routeId               String
  route                 DeliveryRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  destinationLocationId String
  destinationLocation   Location        @relation("RouteDestination", fields: [destinationLocationId], references: [id], onDelete: Cascade)
  sequence              Int
  status                RouteStopStatus @default(PENDING)
  deliveredAt           DateTime?

  items          RouteStopItem[]
  stockMovements StockMovement[]

  @@map("route_stops")
}

model RouteStopItem {
  id          String    @id @default(cuid())
  routeStopId String
  routeStop   RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)

  @@map("route_stop_items")
}

// A manually logged operating expense (rent, utilities, salaries, ...).
// Location is optional — network-wide overhead (e.g. marketing) has none.
// Has its own document lifecycle, same shape as Invoice's supplier side:
// DRAFT (editable, no obligation yet) -> CONFIRMED (a real payable, locked)
// -> paid down via amountPaid, same increment-only pattern as Sale.amountPaid.
// Confirming does NOT itself move money — only recordPayment() does, which
// writes a CashMovement. Cancelling is only possible before any money has
// actually moved (amountPaid = 0), mirroring Invoice/PurchaseOrder cancel.
model Expense {
  id             String          @id @default(cuid())
  organizationId String
  locationId     String?
  location       Location?       @relation(fields: [locationId], references: [id])
  categoryId     String?
  categoryRef    FinanceCategory? @relation(fields: [categoryId], references: [id])
  status         ExpenseStatus   @default(CONFIRMED)
  amount         Decimal         @db.Decimal(12, 2)
  amountPaid     Decimal         @default(0) @db.Decimal(12, 2)
  description    String?
  incurredOn     DateTime        @default(now())
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  cashMovements CashMovement[]

  @@index([organizationId, incurredOn])
  @@map("expenses")
}

// A real member of staff — independent of User (ERP login). Most bakery
// staff (bakers, drivers, sales floor) never log into ArAmir OS at all;
// User is an optional grant of ERP access layered on top of a real
// Employee, not the other way around (see the 1:1 optional userId below).
// Deliberately minimal — this is the HR foundation, not a payroll module:
// no wage-calculation fields live here, see EmployeeCompensation for why
// even the pay rate is a separate append-only history rather than a column.
model Employee {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?      @relation(fields: [locationId], references: [id])

  fullName String
  // Job title (e.g. "Водитель", "Пекарь 2-й категории") — deliberately NOT
  // the same thing as User.role. Role is an ERP permission level and only
  // exists for employees who also have a User account; position exists
  // for every employee regardless of ERP access.
  position String
  phone    String?
  hiredAt  DateTime?
  status   EmployeeStatus @default(ACTIVE)

  // Optional — set only when this employee also has ERP access.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts        Shift[]
  timeEntries   TimeEntry[]
  compensations EmployeeCompensation[]

  @@index([organizationId, locationId])
  @@map("employees")
}

// Append-only history of an employee's pay rate — never overwritten, so
// "what did we pay Данияр in March" stays answerable. Explicitly NOT
// linked to any CashMovement/Expense: a rate here states intent/policy
// ("his rate is 250 000 ₸/мес"), never a fact about money that has
// actually moved. Real salary expense still goes through the existing
// Expense flow (category "Зарплата") exactly as before — this table feeds
// management reporting (e.g. planned labor cost) only. At most one row per
// employee has effectiveTo = null at a time (the current rate); setting a
// new rate closes the previous open-ended row rather than deleting it.
model EmployeeCompensation {
  id             String            @id @default(cuid())
  organizationId String
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount         Decimal           @db.Decimal(12, 2)
  paymentType    CompensationType  @default(MONTHLY)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([organizationId, employeeId])
  @@map("employee_compensations")
}

// A planned work shift for an employee at a location.
model Shift {
  id             String      @id @default(cuid())
  organizationId String
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         ShiftStatus @default(SCHEDULED)
  createdById    String
  createdBy      User        @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())

  @@index([organizationId, locationId])
  @@map("shifts")
}

// Actual attendance — clock in/out. Independent of Shift so employees can
// clock in even without a pre-planned schedule.
model TimeEntry {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  clockInAt      DateTime  @default(now())
  clockOutAt     DateTime?
  // Who performed the clock-in/out action — the employee themself
  // (self-service, when they have ERP access) or a manager acting on
  // their behalf (when they don't). Always set, one code path either way.
  recordedById String
  recordedBy   User   @relation("TimeEntryRecordedBy", fields: [recordedById], references: [id])

  @@index([organizationId, locationId])
  @@index([employeeId])
  @@map("time_entries")
}

// A wholesale/repeat customer (cafe, shop, ...). Not tied to a single
// location — any location can serve them — so this is organization-wide,
// same as the product catalog.
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  lat            Float?
  lng            Float?
  notes          String?
  creditLimit    Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales         Sale[]
  cashMovements CashMovement[]

  @@index([organizationId])
  @@map("customers")
}

// Notifications are never stored themselves — they're computed live from the
// canonical tables (stock levels, invoices, purchase orders, ...) so they can
// never go stale. This table only tracks which computed alert "keys" a user
// has already dismissed, so a dismissed alert stays hidden until the
// underlying condition actually changes and produces a new key.
model NotificationDismissal {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  dismissedAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([organizationId, userId])
  @@map("notification_dismissals")
}

// A bank account or cash register — the two are the same entity with a
// different `type`, same as Location.type or Product.type distinguish their
// own subtypes elsewhere in this schema. CASH accounts belong to one
// Location (a till); BANK accounts are organization-wide. `currentBalance`
// is a cached running total, only ever changed in the same transaction as a
// CashMovement insert against this account (mirrors StockLevel next to
// StockMovement) — never edited directly, including its starting value,
// which is itself the account's first CashMovement (type OPENING_BALANCE).
model CashAccount {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  type           CashAccountType
  locationId     String?
  location       Location?       @relation(fields: [locationId], references: [id])
  // At most one BANK account per organization may be default — the target
  // for non-cash sale receipts when no account is otherwise implied.
  isDefault      Boolean         @default(false)
  currentBalance Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  movements CashMovement[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([locationId])
  @@map("cash_accounts")
}

// Org-scoped, user-managed catalog of income/expense categories — replaces
// what used to be a hardcoded ExpenseCategory enum, same pattern as Category
// (products) and RecipeStageType (recipe process stages): adding a new
// category is a user action, not a code deploy.
model FinanceCategory {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  kind           FinanceCategoryKind
  isActive       Boolean             @default(true)
  // Management-accounting classification for break-even/contribution-margin
  // reporting — only meaningful on EXPENSE categories. Defaults to
  // UNCLASSIFIED and stays that way until the owner (or a reasonable
  // built-in default for well-known seeded categories) sets it explicitly;
  // never inferred from the name at query time.
  costBehavior   CostBehavior        @default(UNCLASSIFIED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  expenses      Expense[]
  cashMovements CashMovement[]
  plannedFixedCosts PlannedFixedCost[]

  @@unique([organizationId, name, kind])
  @@index([organizationId])
  @@map("finance_categories")
}

// A recurring fixed cost the owner EXPECTS each month (rent, electricity,
// internet) — the non-payroll half of planned fixed costs, the payroll half
// being derived live from EmployeeCompensation.
//
// Deliberately a PLAN, never a fact: like EmployeeCompensation, this row is
// never turned into an Expense or CashMovement, automatically or otherwise.
// Real money still moves only through Finance -> Расходы. Planned and actual
// figures are reported side by side and never summed together, so there is
// no path to double-counting.
//
// `amount` is always a PER-MONTH figure — there is no period unit to choose,
// deliberately, since a monthly rate is how every one of these costs is
// actually quoted and a second unit would only invite mismatched arithmetic.
//
// Append-only history, exactly like EmployeeCompensation: raising the rent
// closes the previous open-ended row (effectiveTo) and inserts a new one, so
// "what did we plan for rent in March" stays answerable. At most one row per
// (category, location) pair has effectiveTo = null at a time.
model PlannedFixedCost {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       FinanceCategory @relation(fields: [categoryId], references: [id])
  // Null = organization-wide ("Вся сеть") — e.g. one internet contract for
  // the whole network. Set = this cost belongs to one location only.
  locationId     String?
  location       Location?       @relation(fields: [locationId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([organizationId, categoryId])
  @@map("planned_fixed_costs")
}

// The single append-only ledger of every money movement — the direct
// financial counterpart of StockMovement. Never edited or deleted; a
// mistaken entry is corrected by a new ADJUSTMENT row that references it via
// correctsMovementId, keeping the full history intact and auditable. Nullable
// FKs point at whichever document (if any) caused the movement, the same
// multi-FK-bag shape StockMovement already uses instead of a polymorphic
// reference.
model CashMovement {
  id             String           @id @default(cuid())
  organizationId String
  accountId      String
  account        CashAccount      @relation(fields: [accountId], references: [id])
  type           CashMovementType
  // Positive magnitude for every type except ADJUSTMENT, which stores a
  // signed delta — mirrors StockMovement.quantity's own ADJUSTMENT convention.
  amount         Decimal          @db.Decimal(14, 2)
  occurredAt     DateTime         @default(now())
  reason         String?
  categoryId     String?
  categoryRef    FinanceCategory? @relation(fields: [categoryId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  saleId         String?
  sale           Sale?            @relation(fields: [saleId], references: [id])
  saleReturnId   String?
  saleReturn     SaleReturn?      @relation(fields: [saleReturnId], references: [id])
  expenseId      String?
  expense        Expense?         @relation(fields: [expenseId], references: [id])
  invoiceId      String?
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  // Pairs a transfer's two legs (TRANSFER_OUT on the source account,
  // TRANSFER_IN on the destination) — not a separate Transfer entity.
  transferGroupId String?
  // Self-reference for corrections: points at the movement this ADJUSTMENT
  // is correcting for.
  correctsMovementId String?
  correctsMovement   CashMovement?  @relation("Correction", fields: [correctsMovementId], references: [id])
  correctedBy        CashMovement[] @relation("Correction")
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([organizationId, accountId])
  @@index([occurredAt])
  @@map("cash_movements")
}

// One-time code a logged-in web user generates from Settings → Telegram to
// prove ownership of their ArAmir account to the bot. Linking is always
// initiated from an authenticated web session and consumed by the bot on
// /start <code> — the bot never collects a password, so this token is the
// entire trust boundary. Single-use (consumedAt) and short-lived
// (expiresAt); the code itself is stored hashed, same reasoning as a
// password reset token.
model TelegramLinkToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("telegram_link_tokens")
}

// A write action shown to a Telegram user as a "Подтвердить/Отмена" card,
// staged before execution so a duplicate callback (double-tap, Telegram's
// own retry on a slow response) can be detected and no-opped instead of
// calling the underlying ArAmir service twice. `actionType` + `payload`
// describe the call to make (e.g. InventoryService.writeOff args);
// `resultId` records what was actually created so a duplicate callback can
// be told "already done" with the concrete outcome. Claimed via a single
// conditional UPDATE (status PENDING -> EXECUTING) — see TelegramPendingActionService.
model TelegramPendingAction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId      String
  actionType  String
  payload     Json
  status      String    @default("PENDING")
  resultId    String?
  createdAt   DateTime  @default(now())
  executedAt  DateTime?

  @@index([userId])
  @@map("telegram_pending_actions")
}

// Tracks which step of a multi-step reply flow (e.g. Списание: товар ->
// количество -> причина -> подтверждение) a given Telegram chat is
// currently in, plus the answers collected so far. One row per chat — a
// fresh /start or a completed/cancelled flow clears it. This is UI-wizard
// bookkeeping only, not a business entity.
model TelegramChatState {
  id        String   @id @default(cuid())
  chatId    String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      String?
  data      Json?
  // The bot's single "current screen" message in this chat — every reply
  // edits this message in place instead of sending a new one, so old,
  // superseded prompts stop existing as live, still-tappable buttons rather
  // than needing a runtime guard against them. Survives step/data being
  // cleared between wizards (menu navigation between wizards should still
  // edit the same message), so `clear()` never deletes this row, only
  // resets step/data.
  lastMessageId String?
  updatedAt     DateTime @updatedAt

  @@map("telegram_chat_states")
}

// Dedup log for push notifications sent to Telegram — mirrors
// NotificationDismissal's `key` convention (same {prefix}:{entityId}:{date}
// shape as NotificationsService already produces) so a low-stock condition
// that's still true tomorrow sends again, but doesn't repeat within the
// same day just because the push job runs more than once.
model TelegramNotificationLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
  @@map("telegram_notification_logs")
}
