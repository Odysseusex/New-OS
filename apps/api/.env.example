DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bakery_os"
JWT_SECRET="dev-secret-change-me"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Optional — Telegram bot is disabled (logs a warning, no crash) if
# TELEGRAM_BOT_TOKEN is unset. See README for the full setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Fiscal cash register (ККМ). Everything below is OPTIONAL and the whole
# feature is OFF unless FISCALIZATION_ENABLED is exactly "true".
#
# While it is off, selling behaves exactly as it always has. While it is on,
# a sale is recorded ONLY after the operator registers a fiscal receipt: no
# receipt, no sale, no money, no stock movement. Turn it on only once a real
# receipt has been punched against a live test cash register.
#
# With no re:Kassa credentials set, a fake provider is used — it issues
# receipts that are NOT real, and is meant for local development only.
FISCALIZATION_ENABLED=false
REKASSA_BASE_URL=
REKASSA_API_KEY=
REKASSA_CASH_REGISTER_NUMBER=
REKASSA_CASH_REGISTER_PASSWORD=
